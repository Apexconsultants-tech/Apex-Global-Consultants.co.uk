# Apex Global Consulting Services: apexglobalconsultants.co.uk
# Apache (HostGator shared) behind Cloudflare. Static Astro build + /contact.php.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------------------
  # 1. Force HTTPS and the bare domain (no www).
  #    Cloudflare SSL/TLS mode must be "Full (strict)". X-Forwarded-Proto is
  #    checked so a Cloudflare "Flexible" setting cannot cause a redirect loop.
  # ---------------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://apexglobalconsultants.co.uk%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.apexglobalconsultants\.co\.uk$ [NC]
  RewriteRule ^ https://apexglobalconsultants.co.uk%{REQUEST_URI} [R=301,L,NE]

  # ---------------------------------------------------------------------------
  # 2. Block hidden files and folders (.git, .env ...) except /.well-known/.
  # ---------------------------------------------------------------------------
  RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

  # ---------------------------------------------------------------------------
  # 3. 301 redirects from the old PHP site (full list: docs/redirects.md).
  #    QSD drops old query strings such as ?id=12.
  # ---------------------------------------------------------------------------
  RewriteRule ^index\.php$                        /                                    [R=301,L,QSD]
  RewriteRule ^about\.php$                        /about/                              [R=301,L,QSD]
  RewriteRule ^blog\.php$                         /insights/                           [R=301,L,QSD]
  RewriteRule ^blogs-detail\.php$                 /insights/                           [R=301,L,QSD]
  RewriteRule ^new_highlights\.php$               /insights/                           [R=301,L,QSD]
  RewriteRule ^services?\.php$                    /services/                           [R=301,L,QSD]
  RewriteRule ^book?keeping-service\.php$         /services/accounts-and-bookkeeping/bookkeeping/              [R=301,L,QSD]
  RewriteRule ^accounting-advisory\.php$          /services/reporting-and-advisory/accounting-advisory/       [R=301,L,QSD]
  RewriteRule ^accounting-application\.php$       /services/reporting-and-advisory/accounting-advisory/       [R=301,L,QSD]
  RewriteRule ^taxation-service\.php$             /services/tax/taxation/                  [R=301,L,QSD]
  RewriteRule ^payroll-service\.php$              /services/accounts-and-bookkeeping/payroll-processing/        [R=301,L,QSD]
  RewriteRule ^payroll-processing-service\.php$   /services/accounts-and-bookkeeping/payroll-processing/        [R=301,L,QSD]
  RewriteRule ^corporate-service\.php$            /services/corporate-and-compliance/corporate-services/        [R=301,L,QSD]
  RewriteRule ^compliance-service\.php$           /services/corporate-and-compliance/compliance/                [R=301,L,QSD]
  RewriteRule ^management-reporting\.php$         /services/accounts-and-bookkeeping/management-reporting/      [R=301,L,QSD]
  RewriteRule ^management-reporting-service\.php$ /services/accounts-and-bookkeeping/management-reporting/      [R=301,L,QSD]
  RewriteRule ^specialized-support\.php$          /services/reporting-and-advisory/specialised-support/       [R=301,L,QSD]
  RewriteRule ^specialized-service\.php$          /services/reporting-and-advisory/specialised-support/       [R=301,L,QSD]
  RewriteRule ^careers\.php$                      /about/                              [R=301,L,QSD]
  RewriteRule ^privacy-policy\.php$               /privacy/                            [R=301,L,QSD]
  RewriteRule ^terms-condition\.php$              /terms/                              [R=301,L,QSD]
  # The old site's sitemap address (likely registered in Search Console).
  RewriteRule ^sitemap\.xml$                      /sitemap-index.xml                   [R=301,L,QSD]

  # /contact.php is the live form handler: only GET/HEAD visits are redirected.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^contact\.php$                      /contact/                            [R=301,L,QSD]

  # ---------------------------------------------------------------------------
  # 4. Trailing slash on every page URL (files with an extension are left alone).
  # ---------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Lowercase URLs: Apache cannot lowercase without RewriteMap (not available on
  # shared hosting), so mixed-case page URLs fall through to the 404 page.
</IfModule>

# -----------------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Scripts: own files + Cloudflare Turnstile + Cloudflare Web Analytics. No inline scripts.
  # style-src needs 'unsafe-inline' for style attributes and View Transitions.
  # frame-src: Turnstile widget and the click-to-load Google map on /contact/.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# Caching: hashed assets and fonts for a year, media for a month, HTML briefly.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|avif|webp|jpe?g|png|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(mp4|webm|vtt)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/webm .webm
  AddType text/vtt .vtt
  AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# Compression (Cloudflare also compresses at the edge).
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml text/vtt
</IfModule>
