---
import '../styles/concept-b.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import PreviewStrip from '../components/preview/PreviewStrip.astro';
import Hero from '../components/home/Hero.astro';
import HelpSelector from '../components/home/HelpSelector.astro';
import Explorer from '../components/home/Explorer.astro';
import BadgeSlider from '../components/home/BadgeSlider.astro';
import WhoWeHelp from '../components/home/WhoWeHelp.astro';
import WhyApex from '../components/home/WhyApex.astro';
import SoftwareShowcase from '../components/home/SoftwareShowcase.astro';
import Steps from '../components/home/Steps.astro';
import Switching from '../components/home/Switching.astro';
import Testimonials from '../components/home/Testimonials.astro';
import LatestInsights from '../components/home/LatestInsights.astro';
import FinalCta from '../components/home/FinalCta.astro';
// Homepage design preview 2 ("Summit"). noindex and excluded from the sitemap.
---

<BaseLayout
  title="Homepage preview 2: Summit | Apex Global"
  description="Design preview 2 of the new Apex Global Consulting Services homepage, for review only. Not part of the live site."
  noindex
  samples
  fonts="sans"
>
  <PreviewStrip slot="top" n={2} name="Summit" />
  <Hero />
  <HelpSelector />
  <Explorer />
  <BadgeSlider samples />
  <WhoWeHelp />
  <WhyApex />
  <SoftwareShowcase />
  <Steps />
  <Switching />
  <Testimonials samples />
  <LatestInsights samples />
  <FinalCta />
</BaseLayout>

<script src="../scripts/home.ts"></script>
