---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import FaqList from '../components/page/FaqList.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { getFaqs } from '../lib/content';
import InPageNav from '../components/page/InPageNav.astro';
import { faqSchema } from '../lib/schema';

const topics = [
  { id: 'getting-started', title: 'Getting started' },
  { id: 'fees', title: 'Fees and pricing' },
  { id: 'individuals', title: 'Self Assessment tax returns' },
  { id: 'tax', title: 'Making Tax Digital and VAT' },
  { id: 'payroll', title: 'Payroll and directors' },
  { id: 'companies', title: 'Companies, audit and reporting' },
  { id: 'general', title: 'Working with us' },
  { id: 'overseas', title: 'Overseas companies' },
] as const;
const sets = await Promise.all(topics.map(async (t) => ({ ...t, items: (await getFaqs({ topic: t.id })).map((f) => f.data) })));
const all = sets.flatMap((s) => s.items);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'FAQs', href: '/faq/' },
];
---

<BaseLayout
  title="Accountant FAQs: fees, tax returns, MTD and payroll | Apex Global"
  description="Answers from our Altrincham accountants on fees, Self Assessment tax returns, Making Tax Digital, payroll, audit exemption and switching accountant."
  breadcrumbs={crumbs}
  schema={[faqSchema(all)]}
>
  <PageHero title="Frequently asked questions" summary="Straight answers about fees, tax returns, Making Tax Digital, payroll and how we work." crumbs={crumbs} />
  <InPageNav items={sets.filter((s) => s.items.length).map((s) => ({ id: `faq-${s.id}`, label: s.title }))} />
  {
    sets
      .filter((s) => s.items.length)
      .map((s, i) => (
        <section class:list={['section-sm', { tinted: i % 2 === 1 }]} aria-labelledby={`faq-${s.id}`}>
          <div class="wrap narrow">
            <h2 id={`faq-${s.id}`} class="h3-lg">{s.title}</h2>
            <FaqList items={s.items} />
          </div>
        </section>
      ))
  }
  <FinalCta idPrefix="faq" title="Still have a question?" lead="Call, message or request a call back and a member of the team will help." />
</BaseLayout>
