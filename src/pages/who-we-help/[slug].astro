---
import FaqDeco from '../../components/page/FaqDeco.astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import ServiceCards from '../../components/page/ServiceCards.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import Icon from '../../components/ui/Icon.astro';
import IntroAside from '../../components/page/IntroAside.astro';
import FaqList from '../../components/page/FaqList.astro';
import { getAudiences, getServiceIndex, getFaqsForAudience } from '../../lib/content';
import { faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const audiences = await getAudiences();
  return audiences.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content } = await render(a);
const index = await getServiceIndex();
const services = d.services.map((r) => index.find((i) => i.service.id === r.id)).filter((x): x is (typeof index)[number] => Boolean(x));
const faqs = (await getFaqsForAudience(a.id)).map((f) => f.data);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Who we help', href: '/who-we-help/' },
  { name: d.shortTitle, href: `/who-we-help/${a.id}/` },
];
---

<BaseLayout title={d.seoTitle ?? d.title} description={d.seoDescription} image={d.image} breadcrumbs={crumbs} schema={faqs.length ? [faqSchema(faqs)] : []}>
  <PageHero title={d.title} summary={d.summary} eyebrow={d.shortTitle} crumbs={crumbs} image={d.image} imageAlt={d.imageAlt} />

  <section class="section-sm intro" aria-label="Introduction">
    <div class="wrap intro-grid">
      <div class="prose intro-text">
        <p class="intro-lead">{d.promise}</p>
        <Content />
      </div>
      <IntroAside title="What you get" points={d.benefits} />
    </div>
  </section>

  <section class="section tinted" aria-labelledby="ch-title">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Sound familiar?</p>
        <h2 id="ch-title" class="h2">Challenges we solve</h2>
      </div>
      <ul role="list" class="check-list">
        {d.challenges.map((c) => <li><Icon name="check" size={20} />{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="ben-title">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">What you get</p>
        <h2 id="ben-title" class="h2">How we make it easier</h2>
      </header>
      <ul role="list" class="ben-grid">
        {
          d.benefits.map((b, i) => (
            <li class="ben" data-tone="blue-deep">
              <span class="ben-num">{String(i + 1).padStart(2, '0')}</span>
              <p>{b}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section tinted" aria-labelledby="svc-title">
    <div class="wrap">
      <h2 id="svc-title" class="h2 section-head">Services that help</h2>
      <ServiceCards items={services} />
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="section faq-zone" aria-labelledby="aud-faq-title">
        <FaqDeco words={services.map((x) => x.service.data.title.split(' ')[0])} />
        <div class="wrap narrow">
          <h2 id="aud-faq-title" class="h2 center">Common questions</h2>
          <FaqList items={faqs} />
        </div>
      </section>
    )
  }

  <FinalCta idPrefix={`aud-${a.id}`} />
</BaseLayout>
