---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { site, whatsappHref } from '../data/site';
---

<BaseLayout title="Thank you | Apex Global" description="Thank you for contacting Apex Global Consulting Services. We have received your message and will reply within one working day." noindex>
  <section class="section center-panel">
    <div class="wrap narrow center">
      <span class="done-icon"><Icon name="check" size={32} /></span>
      <h1 class="page-hero-title">Thank you</h1>
      <p class="lead">
        We have received your message and sent a confirmation to your email address. A member of the team will be in touch within one working day.
      </p>
      <p>Need us sooner? Message us on WhatsApp at <a href={whatsappHref} data-track="whatsapp" rel="noopener">{site.whatsapp.display}</a>.</p>
      <div class="center-actions">
        <a href="/services/" class="btn btn-primary">Explore services</a>
        <a href="/" class="btn btn-ghost">Back to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
