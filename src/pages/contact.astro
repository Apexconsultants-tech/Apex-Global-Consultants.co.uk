---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import CallbackForm from '../components/forms/CallbackForm.astro';
import Icon from '../components/ui/Icon.astro';
import { getLocations } from '../lib/content';
import { site, telHref, mailHref, whatsappHref, addressLines } from '../data/site';
import officeMap from '../assets/contact/office-map.webp';

const locations = await getLocations();
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const mapQuery = encodeURIComponent(addressLines.slice(0, 5).join(', '));

const ways = [
  { icon: 'phone', label: 'Call us', value: site.phone.display, action: 'Call now', href: telHref, track: 'call' },
  { icon: 'mail', label: 'Email us', value: site.email, action: 'Send an email', href: mailHref, track: 'email' },
  { icon: 'whatsapp', label: 'WhatsApp', value: site.whatsapp.display, action: 'Start a chat', href: whatsappHref, track: 'whatsapp' },
];
---

<BaseLayout
  title="Contact us and book a free consultation | Apex Global"
  description="Contact Apex Global in Altrincham: call +44 (0)161 4575 303, WhatsApp +44 7777 622790, email info@apexglobalconsultants.co.uk or book a free consultation."
  breadcrumbs={crumbs}
>
  <PageHero title="Contact us" summary="Book a free consultation, request a call back or just ask a question." crumbs={crumbs} />

  <section class="contact-ways-section" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 id="ways-title" class="sr-only">Ways to reach us</h2>
      <ul role="list" class="cways">
        {
          ways.map((w) => (
            <li>
              <a class="cway" href={w.href} data-track={w.track} rel={w.track === 'whatsapp' ? 'noopener' : undefined}>
                <span class="cway-ico">
                  <Icon name={w.icon} size={28} />
                </span>
                <span class="cway-label">{w.label}</span>
                <span class="cway-value wrap-any">{w.value}</span>
                <span class="cway-action">
                  {w.action} <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="cways-hours"><Icon name="clock" size={20} /> {site.hours}. Visits by appointment.</p>
    </div>
  </section>

  <section class="section" aria-label="Book a consultation and find our office">
    <div class="wrap contact-grid">
      <div id="book" class="contact-form">
        <p class="eyebrow">Free consultation</p>
        <h2 class="h3-lg">Book a 30-minute call</h2>
        <p class="contact-lead">Tell us a little about your business and we will arrange a call at a time that suits you.</p>
        <CallbackForm variant="enquiry" idPrefix="contact" />
      </div>

      <div class="contact-side">
        <div class="office-card">
          <div class="office-map" data-map-wrap>
            <Image
              src={officeMap}
              alt="Street map of Altrincham with a pin on Atlantic Street, where our office at the Atlantic Business Centre is"
              width={640}
              height={480}
              widths={[480, 640, 960]}
              sizes="(min-width: 1024px) 34rem, 100vw"
              loading="lazy"
              class="office-map-img"
            />
            <span class="office-pin" aria-hidden="true"><Icon name="building" size={24} /></span>
            <small class="office-map-credit">© OpenStreetMap contributors</small>
          </div>
          <div class="office-body">
            <h2 class="h3-lg">Our office</h2>
            <address>{addressLines.map((l) => <>{l}<br /></>)}</address>
            <div class="office-actions">
              <a href={`https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`} rel="noopener" class="btn btn-primary">
                Get directions <Icon name="external" size={16} />
              </a>
              <button type="button" class="btn btn-outline" data-map-load data-query={mapQuery}>
                <Icon name="pin" size={18} /> Interactive map
              </button>
            </div>
            <p class="office-note">The interactive map loads Google Maps, which may set cookies.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section contact-areas" aria-labelledby="areas-title">
    <div class="wrap">
      <h2 id="areas-title" class="h3-lg">Areas we serve</h2>
      <ul role="list" class="area-tags">
        {locations.map((l) => <li><a href={`/areas/${l.id}/`}>{l.data.town}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // The static map shows straight away (self-hosted image, no third-party request).
  // Google Maps, which may set cookies, loads only when asked for.
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLButtonElement>('[data-map-load]');
    const wrap = document.querySelector<HTMLElement>('[data-map-wrap]');
    if (!btn || !wrap) return;
    btn.addEventListener(
      'click',
      () => {
        const f = document.createElement('iframe');
        f.src = `https://www.google.com/maps?q=${btn.dataset.query}&output=embed`;
        f.title = 'Interactive map showing the Apex Global office in Altrincham';
        f.referrerPolicy = 'no-referrer-when-downgrade';
        f.className = 'map-frame';
        wrap.replaceChildren(f);
        btn.remove();
        f.focus();
      },
      { once: true },
    );
  });
</script>
