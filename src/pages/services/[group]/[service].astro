---
import FaqDeco from '../../../components/page/FaqDeco.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/page/PageHero.astro';
import InPageNav from '../../../components/page/InPageNav.astro';
import FaqList from '../../../components/page/FaqList.astro';
import ServiceCards from '../../../components/page/ServiceCards.astro';
import FinalCta from '../../../components/home/FinalCta.astro';
import Price from '../../../components/ui/Price.astro';
import IntroAside from '../../../components/page/IntroAside.astro';
import Icon from '../../../components/ui/Icon.astro';
import { getServiceIndex, getFaqs, groupHref } from '../../../lib/content';
import { serviceSchema, faqSchema } from '../../../lib/schema';
import { site } from '../../../data/site';

export async function getStaticPaths() {
  const index = await getServiceIndex();
  return index.map((ref) => ({ params: { group: ref.group.id, service: ref.service.id }, props: { ref, index } }));
}
const { ref, index } = Astro.props;
const { service: s, group: g, href, tone } = ref;
const d = s.data;
const { Content } = await render(s);
const faqs = (await getFaqs({ service: s.id })).map((f) => f.data);
const related = d.related.map((r) => index.find((i) => i.service.id === r.id)).filter((x): x is (typeof index)[number] => Boolean(x));
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: g.data.title, href: groupHref(g.id) },
  { name: d.title, href },
];
const nav = [
  { id: 'overview', label: 'Overview' },
  { id: 'included', label: "What's included" },
  ...(d.process ? [{ id: 'process', label: 'How it works' }] : []),
  { id: 'how', label: 'How we help' },
  ...(d.keyDates ? [{ id: 'dates', label: 'Key dates' }] : []),
  { id: 'pricing', label: 'Pricing' },
  ...(faqs.length ? [{ id: 'faqs', label: 'FAQs' }] : []),
];
const schema = [
  serviceSchema({ name: d.title, description: d.summary, url: new URL(href, site.url).href, price: d.price }),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---

<BaseLayout title={d.seoTitle ?? `${d.title} | Apex Global`} description={d.seoDescription} image={d.image} breadcrumbs={crumbs} schema={schema} actionBar>
  <PageHero title={d.title} summary={d.summary} eyebrow={g.data.title} crumbs={crumbs} image={d.image} imageAlt={d.imageAlt} tone={tone} />
  <InPageNav items={nav} />

  <section class="section-sm intro" id="overview" aria-label="Overview">
    <div class="wrap intro-grid">
      <div class="intro-main">
        <div class="prose intro-text">
          <Content />
        </div>
        {
          d.actsFor && (
            <div class="acts">
              <p class="acts-t">We act for</p>
              <ul role="list" class="acts-list">
                {d.actsFor.map((a) => (
                  <li>
                    <Icon name={a.icon} size={18} />
                    {a.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <dl class="intro-stats" data-tone={tone}>
          {
            d.keyFacts.map((f) => (
              <div class="intro-stat">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <IntroAside title="Fixed fees" price={d.price} tone={tone} cta="Get a fixed-fee quote" />
    </div>
    <span data-intro-end></span>
  </section>

  <section class="section tinted" id="included" aria-labelledby="inc-title" data-tone={tone}>
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">What's included</p>
        <h2 id="inc-title" class="h2">Everything covered in our {d.title.toLowerCase()} service</h2>
      </header>
      <ul role="list" class="inc-grid">
        {
          d.included.map((it, i) => (
            <li class="inc-card">
              <span class="inc-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="inc-icon"><Icon name={it.icon} size={24} /></span>
              <h3 class="inc-h">{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    d.process && (
      <section class="section process" id="process" aria-labelledby="process-title" data-tone={tone}>
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">How it works</p>
            <h2 id="process-title" class="h2">From first call to filed return</h2>
          </header>
          <ol role="list" class="process-list">
            {d.process.map((step, i) => (
              <li class="process-step">
                <span class="process-num" aria-hidden="true">{i + 1}</span>
                <h3 class="process-h">{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">How we help</p>
        <h2 id="how-title" class="h2">What working with us looks like</h2>
      </header>
      <div class="rows">
        {
          d.howWeHelp.map((row, i) => (
            <div class="row" data-tone={tone}>
              <div class="row-media">
                <Image src={row.image} alt={row.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 600px, 100vw" class="row-img" loading="lazy" />
              </div>
              <div class="row-copy">
                <span class="row-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="row-h">{row.title}</h3>
                <p>{row.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    d.keyDates && (
      <section class="section tinted" id="dates" aria-labelledby="dates-title" data-tone={tone}>
        <div class="wrap">
          <header class="section-head">
            <p class="eyebrow">Key dates</p>
            <h2 id="dates-title" class="h2">The tax year at a glance</h2>
            <p class="lead">{d.keyDates.intro}</p>
          </header>
          <ol role="list" class="dates">
            {d.keyDates.items.map((it) => (
              <li class="date-item">
                <span class="date-dot" aria-hidden="true">
                  <Icon name="calendar" size={20} />
                </span>
                <p class="date-when">{it.date}</p>
                <h3 class="date-h">{it.title}</h3>
                <p class="date-text">{it.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section" id="pricing" aria-labelledby="price-title">
    <div class="wrap">
      <div class="price-card" data-tone={tone}>
        <div>
          <p class="eyebrow">Pricing</p>
          <h2 id="price-title" class="price-h">{d.title}</h2>
          <p class="price-note">{d.priceNote}</p>
          {
            d.price.features.length > 0 && (
              <ul role="list" class="price-feats">
                {d.price.features.map((f) => (
                  <li>
                    <Icon name="check" size={18} />
                    {f}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="price-side">
          {
            d.price.rows ? (
              <dl class="plan-rows">
                {d.price.rows.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>
                      <span class="price-amount-from">From</span> <strong>{r.amount}</strong> <span class="price-amount-unit">/ {r.unit}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <div>
                <Price price={d.price} />
                {d.price.detail && <p class="plan-detail">{d.price.detail}</p>}
              </div>
            )
          }
          <a href="/contact/#book" class="btn btn-accent btn-block" data-track="booking">Get a fixed-fee quote <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="section tinted faq-zone" id="faqs" aria-labelledby="faq-title">
        <FaqDeco words={[d.title.split(' ')[0], g.data.title.split(' ')[0], 'Tax', 'Advisory']} />
        <div class="wrap narrow">
          <h2 id="faq-title" class="h2 center">{d.title} questions</h2>
          <FaqList items={faqs} />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="rel-title">
        <div class="wrap">
          <h2 id="rel-title" class="h2 section-head">Related services</h2>
          <ServiceCards items={related} />
        </div>
      </section>
    )
  }

  <FinalCta idPrefix={`svc-${s.id}`} title={`Talk to us about ${d.title.toLowerCase()}`} />
</BaseLayout>
