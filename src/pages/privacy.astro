import photo from '../assets/legal/privacy.jpg';

const toc = [
  {
    id: 'part-1',
    label: 'Part 1: Client privacy notice',
    level: 1
  },
  {
    id: 's1-1',
    label: '1.1 Who we are',
    level: 2
  },
  {
    id: 's1-2',
    label: '1.2 What are your rights?',
    level: 2
  },
  {
    id: 's1-3',
    label: '1.3 Data collection',
    level: 2
  },
  {
    id: 's1-4',
    label: '1.4 Use of data',
    level: 2
  },
  {
    id: 's1-5',
    label: '1.5 Anti-money laundering checks',
    level: 2
  },
  {
    id: 's1-6',
    label: '1.6 How long we keep it',
    level: 2
  },
  {
    id: 's1-7',
    label: '1.7 Sharing your personal data',
    level: 2
  },
  {
    id: 'part-2',
    label: 'Part 2: Website privacy notice',
    level: 1
  },
  {
    id: 's2-1',
    label: '2.1 Data collection',
    level: 2
  },
  {
    id: 's2-2',
    label: '2.2 Use of data',
    level: 2
  },
  {
    id: 's2-3',
    label: '2.3 Third parties',
    level: 2
  },
  {
    id: 's2-4',
    label: '2.4 Use of cookies',
    level: 2
  },
  {
    id: 's2-5',
    label: '2.5 Transfer of data outside the UK',
    level: 2
  },
  {
    id: 's2-6',
    label: '2.6 Third-party links',
    level: 2
  },
  {
    id: 's2-7',
    label: '2.7 Your choices',
    level: 2
  },
  {
    id: 's2-8',
    label: '2.8 Access and correction',
    level: 2
  },
  {
    id: 's2-9',
    label: '2.9 Security',
    level: 2
