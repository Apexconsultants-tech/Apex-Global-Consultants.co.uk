---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Steps from '../components/home/Steps.astro';
import Icon from '../components/ui/Icon.astro';
import IntroAside from '../components/page/IntroAside.astro';
import { site, addressLines } from '../data/site';
import aboutImg from '../assets/misc/about.jpg';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
];
const values = [
  { icon: 'scales', title: 'Technical depth', text: 'IFRS, UK GAAP and tax knowledge usually found in large firms, applied to owner-managed businesses.' },
  { icon: 'users', title: 'One point of contact', text: 'A dedicated accountant who knows your business and answers your calls.' },
  { icon: 'pound', title: 'Fixed, clear fees', text: 'A written fixed fee before we start. Extra work is always agreed first.' },
  { icon: 'globe', title: 'UK and beyond', text: 'Support for UK companies and for overseas groups running a UK entity.' },
];
---

<BaseLayout
  title="About us: accountants in Altrincham | Apex Global"
  description="Apex Global is an accounting, tax and financial reporting firm in Altrincham, founded by former PwC and BDO auditor Sandeep Kumar FCA (ICAP), ACCA."
  breadcrumbs={crumbs}
>
  <PageHero
    title="About Apex Global"
    summary="An accounting, tax and financial reporting firm based in Altrincham, working with UK and international businesses."
    eyebrow={site.tagline}
    crumbs={crumbs}
    image={aboutImg}
    imageAlt="A bright, modern office workspace"
  />

  <section class="section-sm intro" aria-label="Our story">
    <div class="wrap intro-grid">
      <div class="prose intro-text">
        <p class="intro-lead">
          Apex Global was founded to give growing businesses access to the technical accounting expertise usually found in large firms, with the personal
          service of a smaller practice.
        </p>
        <p>
          {site.legalName} was set up in England by Sandeep Kumar. Sandeep is a fellow chartered accountant and a chartered certified accountant with more
          than 15 years in external audit and advisory, including managerial positions at PwC UK in London and at BDO overseas.
        </p>
        <p>
          During that time he audited and advised businesses in the United Kingdom and overseas, from owner-managed companies to international groups. He
          saw that growing businesses needed the same technical expertise as large companies, but often found it expensive and rarely dealt with the same
          person twice.
        </p>
        <p>
          Today we support individuals, sole traders, owner-managed businesses, UK subsidiaries of overseas groups and in-house finance teams with
          bookkeeping, tax, payroll, compliance and IFRS and FRS 102 reporting.
        </p>
      </div>
      <IntroAside
        title="Company facts"
        facts={[
          { label: 'Company', value: site.legalName },
          { label: 'Company number', value: site.companyNumber },
          { label: 'Office', value: `${site.address.locality}, ${site.address.region}` },
          { label: 'AML supervisor', value: 'IAB' },
        ]}
      />
    </div>
  </section>

  <section class="section tinted" aria-labelledby="val-title">
    <div class="wrap">
      <h2 id="val-title" class="h2 section-head">What we stand for</h2>
      <ul role="list" class="inc-grid inc-grid--4">
        {
          values.map((v) => (
            <li class="inc-card">
              <span class="inc-icon"><Icon name={v.icon} size={24} /></span>
              <h3 class="inc-h">{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Steps />

  <section class="section tinted" aria-labelledby="co-title">
    <div class="wrap details-grid">
      <div>
        <h2 id="co-title" class="h3-lg">Company details</h2>
        <dl class="details">
          <div><dt>Legal name</dt><dd>{site.legalName}</dd></div>
          <div><dt>Registration</dt><dd>{site.registration}, Company No. {site.companyNumber}</dd></div>
          <div><dt>Registered office</dt><dd>{site.registeredOffice}</dd></div>
          <div><dt>Trading office</dt><dd>{addressLines.join(', ')}</dd></div>
          <div><dt>ICO registration</dt><dd>{site.icoNumber}</dd></div>
        </dl>
      </div>
      <div>
        <h2 class="h3-lg">Regulation</h2>
        <dl class="details">
          <div><dt>Anti-money laundering supervision</dt><dd>{site.compliance.amlSupervisor}</dd></div>
          <div><dt>Professional body</dt><dd>{site.compliance.professionalBody}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <FinalCta idPrefix="about" />
</BaseLayout>

<script src="../scripts/home.ts"></script>
