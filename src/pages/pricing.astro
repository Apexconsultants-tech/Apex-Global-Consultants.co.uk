---
import FaqDeco from '../components/page/FaqDeco.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import FaqList from '../components/page/FaqList.astro';
import FinalCta from '../components/home/FinalCta.astro';
import Icon from '../components/ui/Icon.astro';
import Price from '../components/ui/Price.astro';
import { getServiceIndex, getFaqs } from '../lib/content';
import { faqSchema } from '../lib/schema';

const index = await getServiceIndex();
const faqs = (await getFaqs({ topic: 'fees' })).map((f) => f.data);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Pricing', href: '/pricing/' },
];
const promises = ['Fixed and transparent fees', 'Flexible and scalable', 'UK-based expert support', 'No hidden charges'];
---

<BaseLayout
  title="Accountancy fees and prices from £30 a month | Apex Global"
  description="Starting prices for bookkeeping, payroll, tax returns, management reporting, advisory, company secretarial and compliance work, with fixed fees agreed upfront."
  breadcrumbs={crumbs}
  schema={faqs.length ? [faqSchema(faqs)] : []}
>
  <PageHero
    title="Pricing & Packages"
    summary="Clear, competitive and transparent fees for UK businesses and international clients."
    crumbs={crumbs}
  />

  <section class="section-sm pricing-top" aria-label="Our fee promise">
    <div class="wrap">
      <ul role="list" class="promise-strip">
        {
          promises.map((p) => (
            <li>
              <span class="promise-tick"><Icon name="check" size={18} /></span>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pricing-cards" aria-labelledby="prices-title">
    <div class="wrap">
      <h2 id="prices-title" class="sr-only">Starting prices by service</h2>
      <ul role="list" class="plan-grid">
        {
          index.map(({ service: s, href }, i) => {
            const p = s.data.price;
            // Row one (accounts, payroll, reporting, tax) is blue; row two (advisory, corporate) is green.
            return (
              <li class="plan" data-tone={i < 4 ? 'blue-deep' : 'green-deep'}>
                <div class="plan-head">
                  <span class="plan-icon"><Icon name={s.data.icon} size={24} /></span>
                  <div>
                    <h3 class="plan-title">{s.data.title}</h3>
                    <p class="plan-blurb">{p.blurb}</p>
                  </div>
                </div>

                {p.rows ? (
                  <div class="plan-price plan-price--rows">
                    <p class="plan-rows-cap">From, per {p.rows[0].unit}</p>
                    <dl class="plan-rows">
                      {p.rows.map((r) => (
                        <div>
                          <dt>{r.label}</dt>
                          <dd>
                            <span class="sr-only">from </span>
                            <strong>{r.amount}</strong>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ) : (
                  <div class="plan-price">
                    <Price price={p} />
                    {p.detail && <p class="plan-detail">{p.detail}</p>}
                  </div>
                )}

                <ul role="list" class="ticks plan-ticks">
                  {p.features.map((f) => (
                    <li>
                      <Icon name="check" size={18} />
                      {f}
                    </li>
                  ))}
                </ul>

                <a href={href} class="btn plan-link">
                  Learn more<span class="sr-only"> about {s.data.title.toLowerCase()}</span> <Icon name="arrow" size={18} />
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="plan-note">
        <span class="plan-note-icon"><Icon name="info" size={22} /></span>
        <p>
          <strong>Please note:</strong> prices are starting fees and may vary depending on the size, complexity and specific requirements of your business.
          A clear, fixed-fee proposal will be provided after an initial consultation.
        </p>
        <div class="plan-note-actions">
          <a href="/contact/?subject=Quote%20request#book" class="btn btn-primary" data-track="quote">Request a quote <Icon name="arrow" size={18} /></a>
          <a href="/contact/#book" class="btn btn-green" data-track="booking"><Icon name="calendar" size={18} /> Book a free consultation</a>
        </div>
      </div>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="section tinted faq-zone" aria-labelledby="fees-faq">
        <FaqDeco words={['Fixed fees', 'Bookkeeping', 'Payroll', 'Tax', 'Advisory', 'VAT']} />
        <div class="wrap narrow">
          <h2 id="fees-faq" class="h2 center">Questions about fees</h2>
          <FaqList items={faqs} />
        </div>
      </section>
    )
  }

  <FinalCta idPrefix="pricing" title="Get a fixed-fee proposal" />
</BaseLayout>
