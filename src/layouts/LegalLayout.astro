---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: title, href: path },
];
---

<BaseLayout title={`${title} | Apex Global`} description={description} breadcrumbs={crumbs}>
  <PageHero title={title} summary={`Last updated ${updated}`} crumbs={crumbs} />
  <section class="section-sm">
    <div class="wrap">
      <div class="prose legal">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
