---
// Slim label above the design previews so the two concepts are easy to tell apart. Not part of the design.
interface Props { n: 1 | 2; name: string; }
const { n, name } = Astro.props;
const other = n === 1 ? 2 : 1;
---
<div class="pv-strip">
  <span>Design preview {n} of 2: <strong>{name}</strong></span>
  <a href={`/preview-${other}/`}>View preview {other}</a>
</div>
<style>
  .pv-strip { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .25rem 1rem; padding: .375rem 1rem; background: var(--color-ink); color: var(--color-white); font: 600 .8125rem/1.4 var(--font-body); }
  .pv-strip a { color: var(--color-white); text-decoration: underline; display: inline-flex; min-height: 32px; align-items: center; }
</style>
