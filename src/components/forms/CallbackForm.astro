---
import { env } from '../../data/site';

/**
 * Short callback form. Field names match public/contact.php. Never asks for UTR, NI numbers,
 * bank details or documents (those go through the client portal).
 * Turnstile loads only when the visitor first interacts with the form (forms.ts).
 */
interface Props {
  idPrefix?: string;
  source?: string;
}
const { idPrefix = 'cb', source = Astro.url.pathname } = Astro.props;
const id = (n: string) => `${idPrefix}-${n}`;
---

<form action="/contact.php" method="post" class="form" data-form="callback" novalidate>
  <input type="hidden" name="form_type" value="callback" />
  <input type="hidden" name="source" value={source} />
  <div class="form-row">
    <div class="form-field">
      <label class="label" for={id('name')}>Full name <span aria-hidden="true">*</span></label>
      <input class="field" id={id('name')} name="name" type="text" required autocomplete="name" maxlength="100" />
    </div>
    <div class="form-field">
      <label class="label" for={id('phone')}>Phone <span aria-hidden="true">*</span></label>
      <input class="field" id={id('phone')} name="phone" type="tel" required autocomplete="tel" maxlength="30" />
    </div>
  </div>
  <div class="form-row">
    <div class="form-field">
      <label class="label" for={id('email')}>Email <span aria-hidden="true">*</span></label>
      <input class="field" id={id('email')} name="email" type="email" required autocomplete="email" maxlength="150" />
    </div>
    <div class="form-field">
      <label class="label" for={id('time')}>Best time to call</label>
      <select class="field" id={id('time')} name="best_time">
        <option>Any time</option>
        <option>Morning</option>
        <option>Afternoon</option>
      </select>
    </div>
  </div>
  <div class="hp-field" aria-hidden="true">
    <label for={id('website')}>Leave this field empty</label>
    <input id={id('website')} name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="turnstile-slot" data-sitekey={env.turnstileSiteKey}></div>
  <noscript><p class="form-note">Please enable JavaScript to send this form, or call or email us instead.</p></noscript>
  <p class="form-error" role="alert" data-form-error hidden></p>
  <button type="submit" class="btn btn-primary btn-block">Request a callback</button>
  <p class="form-note">
    By sending this form you agree we may contact you about your enquiry. See our <a href="/privacy/">privacy notice</a>.
  </p>
</form>
