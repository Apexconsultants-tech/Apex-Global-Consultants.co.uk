---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { site, legalLinks, telHref, mailHref, addressLines } from '../../data/site';
import { getGroups, groupHref } from '../../lib/content';

// Deliberately minimal: brand, services, company links, contact details, legal line.
const groups = await getGroups();
const company = [
  { label: 'About us', href: '/about/' },
  { label: 'Who we help', href: '/who-we-help/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'Contact', href: '/contact/' },
];
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLines.join(', '))}`;
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <a href="/" aria-label="Apex Global Consulting Services, home"><Logo width={260} /></a>
      <p class="footer-desc">Accounting, tax and financial reporting for UK and international businesses, from Altrincham.</p>
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div>
        <h2 class="footer-h">Services</h2>
        <ul role="list">
          {groups.map((g) => <li><a href={groupHref(g.id)}>{g.data.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-h">Company</h2>
        <ul role="list">
          {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <address class="footer-contact">
        <h2 class="footer-h">Contact</h2>
        <a href={mapHref} rel="noopener"><Icon name="pin" size={18} /><span>{addressLines.slice(0, 5).join(', ')}</span></a>
        <a href={telHref} data-track="call"><Icon name="phone" size={18} />{site.phone.display}</a>
        <a href={mailHref} data-track="email"><Icon name="mail" size={18} />{site.email}</a>
        <p><Icon name="clock" size={18} />{site.hours}</p>
      </address>
    </nav>
  </div>

  <div class="footer-legal">
    <div class="wrap footer-legal-row">
      <p>
        © <span data-year>{new Date().getFullYear()}</span> {site.legalName}. Registered in England and Wales, Company No. {site.companyNumber}.
        Registered office as above.
      </p>
      <ul role="list" class="footer-legal-links">
        {legalLinks.filter((l) => l.label !== 'Sitemap').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
