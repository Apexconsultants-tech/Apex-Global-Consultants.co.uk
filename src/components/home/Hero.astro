---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import HeroScene from './HeroScene.astro';
import { site, taxReturnHref } from '../../data/site';
import { getSoftware } from '../../lib/content';

/**
 * Split hero: copy on the left, a live "finance desk" scene on the right (HeroScene: HTML, SVG and
 * CSS, no image or video, so the headline is the LCP element). The software the firm works with
 * sits in a small logo row under the buttons. home.ts shows the pause button and pauses the scene
 * off-screen or in a hidden tab.
 */
const h = site.hero;
const software = await getSoftware();
// Four equal tiles: round marks 40px tall, wide wordmarks 30px (CSS caps them to the tile width).
const logoH = (shape: string) => (shape === 'round' ? 40 : 30);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">{site.tagline}</p>
      <h1 id="hero-title" class="hero-title">
        {h.title}
        <span class="hero-title-2">{h.titleAccent}</span>
      </h1>
      <p class="hero-line">{h.line}</p>
      <ul role="list" class="hero-ticks">
        {
          h.points.map((p) => (
            <li>
              <Icon name="check" size={18} />
              {p}
            </li>
          ))
        }
      </ul>
      <div class="hero-actions">
        <a href="/contact/#book" class="btn btn-primary btn-lg" data-track="booking">Book a free consultation</a>
        <a href={taxReturnHref} class="btn btn-green btn-lg" data-track="tax_return">File your tax return</a>
        <a href="#services" class="hero-link">Explore our services <Icon name="arrow" size={18} /></a>
      </div>
      <div class="hero-soft">
        <p class="hero-soft-label">We work with</p>
        <ul role="list" class="hero-soft-list">
          {
            software.map((s) => (
              <li>
                <a href={`/software/${s.id}/`} class="hero-soft-item">
                  <Image
                    src={s.data.logo}
                    alt={s.data.name}
                    height={logoH(s.data.logoShape)}
                    width={Math.round((logoH(s.data.logoShape) * s.data.logo.width) / s.data.logo.height)}
                    densities={[1, 2]}
                    loading="eager"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="hero-visual">
    <HeroScene />
    <button type="button" class="hero-toggle motion-toggle" aria-pressed="false" data-hero-toggle hidden>
      <Icon name="pause" size={18} class="i-pause" /><Icon name="play" size={18} class="i-play" />
      <span class="sr-only">Pause animation</span>
    </button>
  </div>
</section>
