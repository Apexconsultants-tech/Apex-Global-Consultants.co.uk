---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { switching } from '../../data/home';
import photo from '../../assets/misc/switching.jpg';
---

<section class="switch" aria-labelledby="switch-title">
  <div class="wrap switch-row">
    <Image
      src={photo}
      alt="Business owner working on a laptop at a tidy desk"
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 360px, 100vw"
      class="switch-img"
      loading="lazy"
    />
    <div class="switch-copy">
      <h2 id="switch-title" class="switch-h">{switching.title}</h2>
      <p>{switching.text}</p>
    </div>
    <a href={switching.cta.href} class="btn btn-primary">{switching.cta.label} <Icon name="arrow" size={18} /></a>
  </div>
</section>
