---
import { steps } from '../../data/home';
// A line travels from step 1 to step 5 as the visitor scrolls (horizontal on desktop, vertical on
// phones and tablets). home.ts measures the number circles, sets the line length and progress,
// and marks each step active when the line reaches it. Transform only; static under reduced motion.
---

<section class="section steps" aria-labelledby="steps-title" data-steps>
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">How we work</p>
      <h2 id="steps-title" class="h2">{steps.intro}</h2>
    </header>
    <div class="steps-track" data-steps-track>
      <div class="steps-line" aria-hidden="true" data-steps-line>
        <span class="steps-fill"></span>
        <span class="steps-dot"></span>
      </div>
      <ol class="steps-list" role="list">
        {
          steps.items.map((s, i) => (
            <li class="step" data-step data-tone={['blue-deep', 'blue', 'green-deep', 'green', 'blue-deep'][i]}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div class="step-body">
                <h3 class="step-h">
                  <span class="sr-only">Step {i + 1}: </span>
                  {s.title}
                </h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
