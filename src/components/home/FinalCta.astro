---
import Icon from '../ui/Icon.astro';
import CallbackForm from '../forms/CallbackForm.astro';
import { site, telHref, mailHref, whatsappHref } from '../../data/site';

interface Props {
  title?: string;
  lead?: string;
  idPrefix?: string;
}
const {
  title = 'Speak to an accountant today',
  lead = 'Free 30-minute consultation, no obligation. Tell us what you need and we will give you a fixed fee.',
  idPrefix = 'cta',
} = Astro.props;
---

<section class="section final" aria-labelledby={`${idPrefix}-title`} id="callback">
  <div class="wrap final-grid">
    <div class="final-copy">
      <p class="eyebrow">Get in touch</p>
      <h2 id={`${idPrefix}-title`} class="h2">{title}</h2>
      <p class="lead">{lead}</p>
      <ul role="list" class="final-ways">
        <li>
          <a href={telHref} data-track="call">
            <span class="final-ico"><Icon name="phone" /></span>
            <span><small>Call</small>{site.phone.display}</span>
          </a>
        </li>
        <li>
          <a href={whatsappHref} data-track="whatsapp" rel="noopener">
            <span class="final-ico"><Icon name="whatsapp" /></span>
            <span><small>WhatsApp</small>{site.whatsapp.display}</span>
          </a>
        </li>
        <li>
          <a href={mailHref} data-track="email">
            <span class="final-ico"><Icon name="mail" /></span>
            <span><small>Email</small>{site.email}</span>
          </a>
        </li>
        <li>
          <a href="/contact/#book" data-track="booking">
            <span class="final-ico"><Icon name="calendar" /></span>
            <span><small>Book online</small>Choose a time</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="final-form">
      <h3 class="final-form-h">Request a call back</h3>
      <CallbackForm idPrefix={`${idPrefix}-cb`} />
    </div>
  </div>
</section>
