---
import Icon from '../ui/Icon.astro';
import { mailHref, whatsappHref } from '../../data/site';
// Mobile: sticky bottom bar (WhatsApp, Email, Get a quote).
// Desktop: a floating "Get a quote" button that appears once the visitor scrolls past the intro.
---

<nav class="actionbar" aria-label="Quick contact">
  <a href={whatsappHref} data-track="whatsapp" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>
  <a href={mailHref} data-track="email"><Icon name="mail" size={20} />Email</a>
  <a href="/contact/#book" class="actionbar-quote" data-track="booking"><Icon name="pound" size={20} />Get a quote</a>
</nav>
<a href="/contact/#book" class="float-quote btn btn-primary" data-float-quote data-track="booking">
  Get a quote <Icon name="arrow" size={18} />
</a>

<script>
  // Show the desktop "Get a quote" button once the visitor scrolls past the page intro.
  document.addEventListener('astro:page-load', () => {
    const btn = document.querySelector<HTMLElement>('[data-float-quote]');
    const intro = document.querySelector('[data-intro-end]');
    if (!btn || !intro) return;
    const io = new IntersectionObserver(([e]) => btn.toggleAttribute('data-show', e.boundingClientRect.top < 0));
    io.observe(intro);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
